# ==============================================================================
# Gridgeist Discord Bot - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your actual credentials:
#   cp .env.example .env

# ------------------------------------------------------------------------------
# 1. Discord Gateway Configuration (Required)
# ------------------------------------------------------------------------------
# Your Discord bot token from the Discord Developer Portal:
# https://discord.com/developers/applications -> (Select App) -> Bot -> Reset Token
# IMPORTANT: Under "Privileged Gateway Intents", enable "Message Content Intent".
DISCORD_BOT_TOKEN="your_discord_bot_token_here"

# ------------------------------------------------------------------------------
# 2. AI Model Providers (Gemini required, Groq optional)
# ------------------------------------------------------------------------------
# Google Gemini API Key from Google AI Studio:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# (Optional) Groq API Key from Groq Cloud Console:
# https://console.groq.com/keys
# Required only if DEFAULT_AI_PROVIDER is set to "groq"
GROQ_API_KEY=""

# Active default provider for chat completions and memory extraction.
# Supported options: "gemini" | "groq"
# Default: gemini
DEFAULT_AI_PROVIDER="gemini"

# ------------------------------------------------------------------------------
# 3. Database & Memory Layer
# ------------------------------------------------------------------------------
# Filepath for persistent SQLite database (Bun native bun:sqlite).
# Default: ./data/bot.sqlite
DATABASE_PATH="./data/bot.sqlite"

# ------------------------------------------------------------------------------
# 4. Application Runtime Environment
# ------------------------------------------------------------------------------
# Options: "development" | "production" | "test"
# Default: development
NODE_ENV="development"
